{
  "name": "@betty-mini-games/test-liveops-sdk",
  "version": "0.0.1",
  "description": "Front-end games development SDK built on PixiJS v8 and TypeScript",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@esotericsoftware/spine-pixi-v8": "^4.3.13",
    "@pixi/sound": "^6.0.2",
    "bottlejs": "^2.0.1",
    "gsap": "^3.15.1",
    "nixie-fx": "0.1.6",
    "pixi.js": "^8.22.0",
    "xstate": "^5.33.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2"
  }
}
